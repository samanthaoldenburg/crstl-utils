{
  "id": "crstl-utils",
  "title": "CrstlFoundry Utils",
  "description": "A personal module that defines util functions for myself",
  "authors": [
    {
      "name": "Samantha Oldenburg",
      "email": "s.wolfgang.oldenburg@gmail.com"
    }
  ],
  "version": "0.9.4",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "esmodules": [
    "scripts/crstl-utils.js"
  ],
  "url": "https://github.com/samanthaoldenburg/crstl-utils",
  "manifest": "https://github.com/samanthaoldenburg/crstl-utils/releases/latest/download/module.json",
  "download": "https://github.com/samanthaoldenburg/crstl-utils/releases/latest/download/module.zip",
  "readme": "https://github.com/samanthaoldenburg/crstl-utils/blob/main/README.md",
  "packs": [
    {
      "name": "crstl-utils-macros",
      "label": "CrstlUtils Macros",
      "path": "./packs/macros",
      "type": "Macro",
      "ownership": {
        "PLAYER": "NONE",
        "TRUSTED": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "sequencer",
        "manifest": "https://github.com/FantasyCalendar/FoundryVTT-Sequencer/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "3.6.0"
        }
      },
      {
        "id": "advanced-macros",
        "manifest": "https://github.com/mclemente/fvtt-advanced-macros/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "2.3.0"
        }
      }
    ]
  }
}